{% extends "module.html.twig" %}

{% block section %}
    <p>
        Sends an email through the same mail setup as every other email Anyrel sends, so you can
        check that it arrives. Leave the sender empty to use the site's default sender.
    </p>

    <form method="post" action="{{ uri('page.mail.send') }}">
        <div class="form-group mb-3">
            <label for="mail-to" class="form-label">Recipient</label>
            <input id="mail-to" name="mail[to]" type="text" class="form-control" placeholder="Name &lt;address@example.com&gt;, address-2@example.com" required="required" />
        </div>

        <div class="form-group mb-3">
            <label for="mail-from" class="form-label">Sender (optional)</label>
            <input id="mail-from" name="mail[from]" type="text" class="form-control" placeholder="site default" />
        </div>

        <div class="form-group mb-3">
            <label for="mail-subject" class="form-label">Subject</label>
            <input id="mail-subject" name="mail[subject]" type="text" class="form-control" value="Test email" required="required" />
        </div>

        <div class="form-group mb-3">
            <label for="mail-body" class="form-label">Message</label>
            <textarea id="mail-body" name="mail[body]" class="form-control" rows="5">This is a test email.</textarea>
        </div>

        <button type="submit" class="btn btn-primary">
            {{ include('t3-icon.html.twig', {name:'envelope'}) }}
            send email
        </button>
    </form>
{% endblock %}
